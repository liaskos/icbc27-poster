	note = {Artwork Size: 19 pages, 852009 bytes
ISBN: 9783959772198
Medium: application/pdf},
	keywords = {Blockchain, Byzantine tolerant implementations, consistency properties, Theory of computation},
	pages = {6:1--6:19},
	annote = {SeriesInformation
LIPIcs, Vol. 217, 25th International Conference on Principles of Distributed Systems (OPODIS 2021), pages 6:1-6:19},
	file = {PDF:C\:\\Users\\sotirios\\Zotero\\storage\\6MUQC38V\\Anceaume et al. - 2022 - On Finality in Blockchains.pdf:application/pdf},
