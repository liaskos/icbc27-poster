@article{grunspan_profitability_2022,
	title = {On {Profitability} of {Nakamoto} double spend},
	volume = {36},
	issn = {0269-9648, 1469-8951},
	url = {http://arxiv.org/abs/1912.06412},
	doi = {10.1017/S026996482100005X},
	abstract = {Nakamoto double spend strategy, described in Bitcoin foundational article, leads to total ruin with positive probability and does not make sense from the proﬁtability point of view. The simplest strategy that can be proﬁtable incorporates a stopping threshold when success is unlikely. We solve and compute the exact proﬁtability for this strategy. We compute the minimal amount of the double spend that is proﬁtable. For a given amount of the transaction, we determine the minimal number of conﬁrmations to be requested by the recipient such that this double spend strategy is non-proﬁtable. We ﬁnd that this number of conﬁrmations is only 1 or 2 for average transactions and a small hashrate of the attacker. This is substantially lower than the original Nakamoto numbers that are widely used and are only based on the success probability instead of the proﬁtability.},
	language = {en},
	number = {3},
	urldate = {2026-04-05},
	journal = {Probability in the Engineering and Informational Sciences},
	author = {Grunspan, Cyril and Pérez-Marco, Ricardo},
	month = jul,
	year = {2022},
	note = {arXiv:1912.06412 [cs]},
	keywords = {Computer Science - Cryptography and Security, Mathematics - Probability},
	pages = {732--746},
	annote = {Comment: 15 pages, 4 figures},
	file = {PDF:C\:\\Users\\sotirios\\Zotero\\storage\\ELVCBPDD\\Grunspan and Pérez-Marco - 2022 - On Profitability of Nakamoto double spend.pdf:application/pdf},
}


