@article{muller_tangle_2022,
	title = {Tangle 2.0 {Leaderless} {Nakamoto} {Consensus} on the {Heaviest} {DAG}},
	volume = {10},
	issn = {2169-3536},
	url = {https://ieeexplore.ieee.org/abstract/document/9907014},
	doi = {10.1109/ACCESS.2022.3211422},
	abstract = {We introduce the theoretical foundations of the Tangle 2.0, a probabilistic leaderless consensus protocol based on a directed acyclic graph (DAG) called the Tangle. The Tangle naturally succeeds the blockchain as its next evolutionary step as it offers features suited to establish more efficient and scalable distributed ledger solutions. Consensus is no longer found in the longest chain but on the heaviest DAG, where PoW is replaced by a stake- or reputation-based weight function. The DAG structure and the underlying Reality-based UTXO Ledger allow parallel validation of transactions without the need for total ordering. Moreover, it enables the removal of the intermediary of miners and validators, allowing a pure two-step process that follows the propose-vote paradigm at the node level and not at the validator level. We propose a framework to analyse liveness and safety under different communication and adversary models. This allows providing impossibility results in some edge cases and in the asynchronous communication model. We provide formal proof of the security of the protocol assuming a common random coin.},
	urldate = {2025-08-22},
	journal = {IEEE Access},
	author = {Müller, Sebastian and Penzkofer, Andreas and Polyanskii, Nikita and Theis, Jonas and Sanders, William and Moog, Hans},
	year = {2022},
	keywords = {Protocols, Distributed ledger, Security, security, Consensus protocol, Safety, asynchronous, directed acyclic graph, Directed acyclic graph, Fault tolerance, fault-tolerance, leaderless},
	pages = {105807--105842},
	file = {Full Text PDF:C\:\\Users\\sotirios\\Zotero\\storage\\WYIA4ML6\\Müller et al. - 2022 - Tangle 2.0 Leaderless Nakamoto Consensus on the Heaviest DAG.pdf:application/pdf},
}



