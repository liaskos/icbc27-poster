@article{zhu_survey_2018,
	title = {A survey: {Reward} distribution mechanisms and withholding attacks in {Bitcoin} pool mining},
	volume = {1},
	issn = {2577-8838},
	shorttitle = {A survey},
	url = {http://aimsciences.org//article/doi/10.3934/mfc.2018020},
	doi = {10.3934/mfc.2018020},
	abstract = {The past three years have seen the rapid increase of Bitcoin diﬃculty, which has led to a substantial variance in solo mining. As a result, miners tend to join a large open pool to get a more stable reward. Nowadays, mining pools take up over 98\% of Bitcoins total computation power. In a sense, this is a manifestation of Bitcoin that tends to be centralized. Thus, researchers have shown an increased interest in pool mining payoﬀ and security. The purpose of this paper is to review and summarize recent research in Bitcoin pool mining system. We ﬁrst introduce several common reward distribution schemes, and analyze their advantages and disadvantages with some improvement mechanisms; In the second section, to address pool security problems, we examined the practical utility of some existing and potential attack strategies. To study those malicious attack in details, several defense methods are collected. Finally, we make an outlook on Bitcoin future.},
	language = {en},
	number = {4},
